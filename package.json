{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/selected-problems.test.mjs tests/statement-headings.test.mjs tests/statement-images.test.mjs tests/statement-math.test.mjs tests/training-core.test.mjs tests/training-view-model.test.mjs tests/phors-importer.test.mjs tests/openai-translation-transport.test.mjs",
    "test:hints": "node --test tests/ai-hints.test.mjs tests/marking-scheme.test.mjs",
    "test:training": "node --test tests/training-core.test.mjs",
    "test:phors": "node --test tests/phors-importer.test.mjs",
    "phors:sync": "node scripts/sync-phors.mjs",
    "phors:sync:full": "node scripts/sync-phors.mjs --xy-2018-2026 --db data/phors-full.sqlite --export data/phors-full.json",
    "phors:audit-parts": "node scripts/audit-phors-part-codes.mjs data/phors-full.sqlite",
    "phors:repair-parts": "node scripts/repair-phors-part-codes.mjs data/phors-full.sqlite",
    "validate:phors": "node scripts/validate-phors-catalog.mjs",
    "validate:translations": "node scripts/validate-phors-translations.mjs",
    "translate:prepare:x24": "python scripts/external-phors-translation.py prepare --exam X24 --max-chars 3000",
    "translate:apply:x24": "python scripts/external-phors-translation.py apply",
    "phors:site-data": "node scripts/build-phors-site-data.mjs",
    "validate:site-data": "node scripts/validate-phors-site-data.mjs",
    "phors:sample": "node scripts/sync-phors.mjs --db data/phors-sample.sqlite --export data/phors-sample.json --limit-per-exam 2 https://xy.pho.rs/W25 https://xy.pho.rs/X24 https://xy.pho.rs/Y25",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
